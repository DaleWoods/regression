# =============================================================================
# WOSG UK Playwright framework — environment template
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
#   cp .env.example .env
#
# In CI these are supplied as GitHub Secrets (see .github/workflows/*.yml).
# Every key marked [REQUIRED] is validated at startup by config/validateEnv.ts,
# which fails fast with a clear message rather than letting a test die on a
# confusing timeout (spec §5).
# =============================================================================

# -----------------------------------------------------------------------------
# Target environment
# -----------------------------------------------------------------------------
# Which environment the run targets. Phase 1 supports `uat` only; `dev` and
# `staging` slots are already defined in config/environments.ts so a new
# environment needs no refactor (spec §5).
# Allowed: dev | staging | uat
TEST_ENV=uat

# -----------------------------------------------------------------------------
# Storefront base URLs  [REQUIRED]
# -----------------------------------------------------------------------------
# One per site, per environment. The suffix must match TEST_ENV uppercased.
# NOTE: production hostnames are rejected by the hard guard in
# config/productionGuard.ts — the framework refuses to start (spec §5).
GOLDSMITHS_BASE_URL_UAT=https://goldsmiths-uat.thewosgroup.com
MAPPIN_WEBB_BASE_URL_UAT=https://mappinandwebb-uat.thewosgroup.com
WOS_BASE_URL_UAT=https://watches-uat.thewosgroup.com

# Optional: fill these in only when the corresponding environment is stood up.
# GOLDSMITHS_BASE_URL_STAGING=
# MAPPIN_WEBB_BASE_URL_STAGING=
# WOS_BASE_URL_STAGING=
# GOLDSMITHS_BASE_URL_DEV=
# MAPPIN_WEBB_BASE_URL_DEV=
# WOS_BASE_URL_DEV=

# -----------------------------------------------------------------------------
# Storefront test accounts
# -----------------------------------------------------------------------------
# Domain used when userFactory generates fresh accounts, e.g.
#   qa.auto+1737031234567-a1b2c3d4@thewosgroup.com
# Fresh account per run — never a shared login for state-mutating tests (spec §8).
TEST_USER_EMAIL_DOMAIN=thewosgroup.com
TEST_USER_PASSWORD=ChangeMe_Str0ng!

# Optional pre-existing read-only account, for tests that must NOT create data.
# EXISTING_USER_EMAIL=
# EXISTING_USER_PASSWORD=

# -----------------------------------------------------------------------------
# Payments (UAT / Adyen test values only — never real card data)  [REQUIRED for @checkout]
# -----------------------------------------------------------------------------
# OPEN ITEM (spec §15): confirm the default happy-path payment method for UAT
# and the sanctioned Adyen test card before checkout tests are written.
# The values below are the public Adyen test Mastercard — replace if WOSG UAT
# is configured differently.
PAYMENT_CARD_NUMBER=5555444433331111
PAYMENT_CARD_EXPIRY=03/30
PAYMENT_CARD_CVC=737
PAYMENT_CARD_HOLDER=QA Automation

# -----------------------------------------------------------------------------
# SAP ERP — SAP GUI for HTML (Webgui). QA INSTANCE ONLY.  [REQUIRED for @erp]
# -----------------------------------------------------------------------------
# The production ERP host is blocklisted in config/productionGuard.ts and the
# framework will throw rather than connect to it (spec §5, §9.1).
ERP_BASE_URL=https://sapqa.thewosgroup.com/sap/bc/gui/sap/its/webgui
ERP_CLIENT=100
ERP_USER=
ERP_PASSWORD=
ERP_LANGUAGE=EN

# -----------------------------------------------------------------------------
# BrowserStack (opt-in only — `npm run test:browserstack`)  [REQUIRED for that script]
# -----------------------------------------------------------------------------
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Run tuning (all optional — sensible defaults in playwright.config.ts)
# -----------------------------------------------------------------------------
# HEADED=1              # run with a visible browser locally
# WORKERS=4             # override worker count for storefront projects
# RETRIES=0             # override retry count (CI defaults to 2, local to 0)
# LOG_LEVEL=info        # error | warn | info | debug
