{
  "name": "bis-app",
  "private": true,
  "version": "1.0.0",
  "description": "Business Impact Scoring (BIS) application - WOSG",
  "workspaces": [
    "server",
    "web",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace web",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "test:e2e": "npm run test --workspace e2e",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web"
  },
  "engines": {
    "node": ">=20"
  }
}
