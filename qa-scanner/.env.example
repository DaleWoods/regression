# ── Server ────────────────────────────────────────────────────────────────
# Bind address. 0.0.0.0 so colleagues on the office network can reach it.
HOST=0.0.0.0
PORT=3000

# ── Login wall ────────────────────────────────────────────────────────────
# Shared password for the dashboard. REQUIRED — the server refuses to start
# without it (set AUTH_DISABLED=1 only for local development).
DASHBOARD_PASSWORD=change-me

# Optional per-user logins instead of the shared password, comma separated:
# DASHBOARD_USERS=alice:pw1,bob:pw2

# Secret used to sign session cookies. Any long random string. If unset, one
# is derived from the password (sessions then reset when the password changes).
SESSION_SECRET=

# ── Anthropic API (semantic copy checks) ──────────────────────────────────
# Server-side only; never sent to the browser. Leave unset to disable the
# semantic checks (all other checks still run).
ANTHROPIC_API_KEY=
SEMANTIC_MODEL=claude-opus-5
SEMANTIC_EFFORT=medium

# ── Crawler behaviour ─────────────────────────────────────────────────────
# User-Agent for every request the scanner makes (page loads, sub-resources,
# link checks). Match this string in the Akamai allowlist. The default lives
# in src/config.js.
SCANNER_USER_AGENT=WoSG-QA-Scanner/1.0 (+internal-qa)

# Pages rendered in parallel (keep modest — polite to production).
SCAN_CONCURRENCY=2
# Parallel outbound link checks.
LINK_CONCURRENCY=4
# Max pages per scan (sitemap is truncated to this).
MAX_PAGES=100
# Max distinct links checked per page.
MAX_LINKS_PER_PAGE=150
# Page navigation timeout, ms.
NAV_TIMEOUT_MS=45000
# Optional: path to a Chromium binary if `npx playwright install` isn't
# possible on the host (e.g. a system-installed chromium).
# CHROMIUM_PATH=/usr/bin/chromium

# Where per-brand results are stored (JSON on disk).
# DATA_DIR=/var/lib/qa-scanner/data
